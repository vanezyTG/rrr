-- Grip drag logic
local function makeGripDrag(h,onP,onR)
    local drag,sm,sx,sy=false,nil,0,0
    h.InputBegan:Connect(function(i)
        if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
        if resizeActive then return end; drag=true; sm=UserInputService:GetMouseLocation(); sx,sy=winPosX,winPosY; if onP then onP() end
    end)
    conn(UserInputService.InputChanged:Connect(function(i)
        if not drag then return end
        if i.UserInputType~=Enum.UserInputType.MouseMovement and i.UserInputType~=Enum.UserInputType.Touch then return end
        local d=UserInputService:GetMouseLocation()-sm; winPosX=sx+d.X; winPosY=sy+d.Y
        win.Position=UDim2.new(0.5,winPosX,0.5,winPosY); shadow.Position=UDim2.new(0.5,winPosX,0.5,winPosY)
    end))
    conn(UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
        if drag and onR then onR() end; drag=false
    end))
end

