        return b
    end
    local saveBtn=actBtn("Save",rgb(40,168,74)); local exitBtn=actBtn("Exit",rgb(180,44,50))
    local handles={}; local startW,startH,startMouse,activeHandle; local ssW,ssH=0,0
    local function mkHandle(edge)
        local h=Instance.new("TextButton"); h.Text=""; h.AutoButtonColor=false; h.BackgroundColor3=W3
        h.BackgroundTransparency=0.22; h.Visible=false; h.ZIndex=55; h.Parent=win; corner(h,5)
        local hg=Instance.new("UIGradient"); hg.Parent=h
        onTheme(function(p) hg.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,p:Lerp(BK,0.62)),ColorSequenceKeypoint.new(0.5,p:Lerp(W3,0.28)),ColorSequenceKeypoint.new(1,p:Lerp(BK,0.62))}) end)
        if edge=="left"   then h.AnchorPoint=Vector2.new(0,0.5); h.Position=UDim2.new(0,4,0.5,0); h.Size=UDim2.new(0,7,0,66)
        elseif edge=="right"  then h.AnchorPoint=Vector2.new(1,0.5); h.Position=UDim2.new(1,-4,0.5,0); h.Size=UDim2.new(0,7,0,66)
        elseif edge=="top"    then h.AnchorPoint=Vector2.new(0.5,0); h.Position=UDim2.new(0.5,0,0,4); h.Size=UDim2.new(0,78,0,7)
        else h.AnchorPoint=Vector2.new(0.5,1); h.Position=UDim2.new(0.5,0,1,-4); h.Size=UDim2.new(0,78,0,7) end
        h.InputBegan:Connect(function(i)
            if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
            activeHandle=edge; startW,startH=W,H; startMouse=UserInputService:GetMouseLocation(); tw(h,0.10,{BackgroundTransparency=0})
        end)
        h.MouseEnter:Connect(function() tw(h,0.10,{BackgroundTransparency=0.06}) end)
        h.MouseLeave:Connect(function() if activeHandle~=edge then tw(h,0.13,{BackgroundTransparency=0.22}) end end)
        handles[edge]=h
    end
    mkHandle("left"); mkHandle("right"); mkHandle("top"); mkHandle("bottom")
    conn(UserInputService.InputChanged:Connect(function(i)
        if not activeHandle then return end
        if i.UserInputType~=Enum.UserInputType.MouseMovement and i.UserInputType~=Enum.UserInputType.Touch then return end
        local d=UserInputService:GetMouseLocation()-startMouse
        if activeHandle=="right" then applyWindowSize(startW+d.X*2,H) elseif activeHandle=="left" then applyWindowSize(startW-d.X*2,H)
        elseif activeHandle=="bottom" then applyWindowSize(W,startH+d.Y*2) elseif activeHandle=="top" then applyWindowSize(W,startH-d.Y*2) end
    end))
    conn(UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
        if activeHandle and handles[activeHandle] then tw(handles[activeHandle],0.13,{BackgroundTransparency=0.22}) end; activeHandle=nil
    end))
    local function setResVis(on)
        dim.Visible=true; acts.Visible=true; for _,h in pairs(handles) do h.Visible=true end
        if on then tw(dim,0.26,{BackgroundTransparency=0.50}) end
    end
    local function finishResize()
        resizeActive=false; tw(dim,0.24,{BackgroundTransparency=1}); for _,h in pairs(handles) do tw(h,0.17,{BackgroundTransparency=1}) end
        task.delay(0.26,function()
            if not resizeActive then dim.Visible=false; acts.Visible=false; for _,h in pairs(handles) do h.Visible=false; h.BackgroundTransparency=0.22 end end
        end)
    end
    enterResize=function()
        if resizeActive then return end; resizeActive=true; ssW,ssH=W,H; setResVis(true); notify("Resize mode","Drag handles to resize. Save or Exit when done.",6,true)
    end
    saveBtn.MouseButton1Click:Connect(function() saveConfig(); finishResize(); notify("Size saved","Window size stored.",3,true) end)
    exitBtn.MouseButton1Click:Connect(function()
        if W==ssW and H==ssH then finishResize(); return end; acts.Visible=false
        showConfirm("Keep new size?","Save or revert to old size.",
            function() saveConfig(); finishResize(); notify("Size saved","New size kept.",3,true) end,
            {yesText="Keep",noText="Revert",noDismiss=true,onNo=function() applyWindowSize(ssW,ssH,true); finishResize() end})
    end)
end

