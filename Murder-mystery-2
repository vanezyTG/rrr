-- Animate items into view (staggered slide from left)
local function animateItems(scroll)
    local children={}
    for _,c in ipairs(scroll:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextLabel") then children[#children+1]=c end
    end
    table.sort(children,function(a,b) return (a.LayoutOrder or 0)<(b.LayoutOrder or 0) end)
    for i,child in ipairs(children) do
        local origPos=child.Position
        child.Position=UDim2.new(origPos.X.Scale-0.10,origPos.X.Offset,origPos.Y.Scale,origPos.Y.Offset)
        for _,d in ipairs(child:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                pcall(function() d.TextTransparency=0.8 end)
            end
        end
        task.delay((i-1)*0.045,function()
            if child and child.Parent then
                tw(child,0.32,{Position=origPos},Enum.EasingStyle.Quart)
