-- WINDOW OPEN/CLOSE → particles fly to orb
-- ═══════════════════════════════════
local function setWindow(show)
    if winCooldown then return end
    winCooldown=true

    if show then
        win.Visible=true; shadow.Visible=true
        -- Expand from orb position
        local vp=Camera.ViewportSize
        win.AnchorPoint=Vector2.new(0.5,0.5)
        win.Position=UDim2.new(0,orbCX,0,orbCY)
        win.Size=UDim2.new(0,12,0,12)
        shadow.Size=UDim2.new(0,6,0,6)
        shadow.Position=UDim2.new(0,orbCX,0,orbCY+10)
        tw(win,0.50,{Size=UDim2.new(0,W,0,H),Position=UDim2.new(0.5,winPosX,0.5,winPosY)},Enum.EasingStyle.Back)
        tw(shadow,0.50,{Size=UDim2.new(0,W+20,0,H+20),Position=UDim2.new(0.5,winPosX,0.5,winPosY+12)},Enum.EasingStyle.Back)
        task.delay(0.30,function() winCooldown=false end)
    else
        -- Spawn small colored particles that fly toward orb
        local numP=8
        local targX=orbCX; local targY=orbCY
        local vp=Camera.ViewportSize
        -- Get window screen position
        local winScrX=vp.X/2+winPosX; local winScrY=vp.Y/2+winPosY

        for i=1,numP do
            local p=Instance.new("Frame")
            local sz=math.random(6,14)
            p.AnchorPoint=Vector2.new(0.5,0.5)
            p.Size=UDim2.new(0,sz,0,sz)
            -- Spread from window center
            local sx=winScrX+(math.random()-0.5)*W*0.7
            local sy=winScrY+(math.random()-0.5)*H*0.7
            p.Position=UDim2.new(0,sx,0,sy)
            p.BackgroundColor3=theme.primary; p.BackgroundTransparency=0.1
            p.BorderSizePixel=0; p.ZIndex=50; p.Parent=SG; corner(p,sz/2)
            -- Fly to orb
            local delay2=(i-1)*0.032
            task.delay(delay2,function()
                tw(p,0.38,{Position=UDim2.new(0,targX,0,targY),Size=UDim2.new(0,4,0,4),BackgroundTransparency=0.92},Enum.EasingStyle.Quart)
                task.delay(0.40,function() if p then p:Destroy() end end)
            end)
        end

        -- Shrink window to orb
        tw(win,0.36,{Size=UDim2.new(0,10,0,10),Position=UDim2.new(0,orbCX,0,orbCY)},Enum.EasingStyle.Quart)
        tw(shadow,0.30,{Size=UDim2.new(0,4,0,4),BackgroundTransparency=0.72},Enum.EasingStyle.Quart)

        task.delay(0.38,function()
            if not windowShown then
                win.Visible=false; shadow.Visible=false
                win.Size=UDim2.new(0,W,0,H); win.Position=UDim2.new(0.5,winPosX,0.5,winPosY)
                shadow.Size=UDim2.new(0,W+20,0,H+20); shadow.BackgroundTransparency=0.72
                shadow.Position=UDim2.new(0.5,winPosX,0.5,winPosY+12)
            end
        end)
        task.delay(0.30,function() winCooldown=false end)
    end
    windowShown=show
end

