    b.MouseEnter:Connect(function() tw(b,0.15,{BackgroundTransparency=0,TextColor3=W3}) end)
    b.MouseLeave:Connect(function() tw(b,0.20,{BackgroundTransparency=0.30,TextColor3=theme.sub}) end)
    b.MouseButton1Down:Connect(function()
        tw(b,0.08,{Size=UDim2.new(0,sz-4,0,sz-4),Position=UDim2.new(1,xOff+2,0.5,-(sz-4)/2)},Enum.EasingStyle.Quad)
    end)
    b.MouseButton1Up:Connect(function()
        twBack(b,0.20,{Size=UDim2.new(0,sz,0,sz),Position=UDim2.new(1,xOff,0.5,-sz/2)})
    end)
    return b
end
