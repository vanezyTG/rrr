local function pickIcon(title,desc,isSystem)
    local t=title:lower()
    if t:find("cop") then return "copy"
    elseif t:find("sav") then return "save"
    elseif t:find("reset") or t:find("restor") then return "warn"
    elseif t:find("map") then return "map"
    elseif t:find("resize") or t:find("size") then return "resize"
    elseif t:find("disab") or t:find("off") or t:find("silence") then return "off"
    elseif t:find("enabl") or t:find("welcom") or t:find("load") or t:find("appli") then return "ok"
    elseif t:find("warn") then return "warn"
    else return "info" end
end

local function notify(title,desc,dur,isSystem)
    if notifSilent and not isSystem then return end
    dur=dur or 3.5
