    local function actBtn(txt,col)
        local b=Instance.new("TextButton"); b.Size=UDim2.new(0,108,0,40); b.BackgroundColor3=col; b.Text=txt
        b.Font=Enum.Font.GothamBold; b.TextSize=14; b.TextColor3=W3; b.AutoButtonColor=false; b.ZIndex=53; b.Parent=acts; corner(b,12); stroke(b,W3,1,0.84)
        b.MouseEnter:Connect(function() tw(b,0.12,{BackgroundColor3=col:Lerp(W3,0.16),Size=UDim2.new(0,112,0,42)}) end)
        b.MouseLeave:Connect(function() tw(b,0.16,{BackgroundColor3=col,Size=UDim2.new(0,108,0,40)}) end)
        b.MouseButton1Down:Connect(function() tw(b,0.07,{BackgroundColor3=col:Lerp(BK,0.16)},Enum.EasingStyle.Quad) end)
