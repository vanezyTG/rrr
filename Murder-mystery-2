conn(RunService.RenderStepped:Connect(function()
    local t=os.clock()
    -- Blob animation
    for i,bl in ipairs(blobs) do
        local p2=0.93+0.05*math.sin(t*0.4+bl.bd.phase)
        local s2=bl.bd.sz*p2
        bl.f.Size=UDim2.new(s2,0,s2*1.3,0)
        bl.f.BackgroundTransparency=0.92+0.04*math.sin(t*0.35+bl.bd.phase)
        -- Very slow drift
        bl.f.Position=UDim2.new(bl.bd.ax+0.05*math.sin(t*0.12+bl.bd.phase),0,bl.bd.ay+0.04*math.cos(t*0.09+bl.bd.phase),0)
    end
    -- Line sweep
    sweep.Position=UDim2.new(0,0,(((t*0.04)%1)),0)
    sweep.BackgroundTransparency=0.93+0.04*math.sin(t*0.5)
    -- Header shimmer
    titleG.Offset=Vector2.new(math.sin(t*0.58)*0.36,0)
    logoG.Offset=Vector2.new(math.sin(t*1.0)*0.22,0)
    mmG.Offset=Vector2.new(math.sin(t*0.58)*0.36,0)
    -- Shadow breathe
    shadow.BackgroundTransparency=0.72+0.06*math.sin(t*0.42)
end))

