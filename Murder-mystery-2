local function updateMinimap()
    if not MapSettings.Enabled or not mapFrame then return end
    local sz=MapSettings.Size; local rad=MapSettings.WorldRadius; local lp=LP.Character; if not lp then return end
    local lr=lp:FindFirstChild("HumanoidRootPart"); if not lr then return end
    local lpos=lr.Position; local angle=math.atan2(Camera.CFrame.LookVector.X,Camera.CFrame.LookVector.Z)
    if mapLocalDot then mapLocalDot.Position=UDim2.new(0.5,0,0.5,0) end
    local seen={}
    for _,pl in pairs(Players:GetPlayers()) do
        if pl~=LP and pl.Character then
            local root=pl.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local rel=root.Position-lpos; local nx=rel.X/rad; local nz=rel.Z/rad
                local rx=nx*math.cos(angle)+nz*math.sin(angle); local ry=-nx*math.sin(angle)+nz*math.cos(angle)
                rx=math.clamp(rx,-0.43,0.43); ry=math.clamp(ry,-0.43,0.43)
                local dot=getOrCreateDot(pl)
                if dot then
                    local isFr=false; for _,fn in pairs(FriendList) do if fn==pl.Name then isFr=true; break end end
                    dot.BackgroundColor3=isFr and rgb(60,220,110) or rgb(228,50,60)
                    dot.Position=UDim2.new(0.5+rx,0,0.5+ry,0); seen[pl]=true
                end
            end
        end
    end
    for pl,dot in pairs(mapDots) do if not seen[pl] then if dot and dot.Parent then dot:Destroy() end; mapDots[pl]=nil end end
end
conn(RunService.RenderStepped:Connect(function() if MapSettings.Enabled then updateMinimap() end end))

