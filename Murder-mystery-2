local function loadConfig()
    if not _if(CFG_PATH) then return end
    local ok,d=pcall(function() return HttpService:JSONDecode(_rf(CFG_PATH)) end)
    if not ok or type(d)~="table" then return end
    if d.color and PMAP[d.color] then theme.key=d.color; theme.primary=PMAP[d.color].c end
    for k,v in pairs(d) do if cfg[k]~=nil then cfg[k]=v end end
end
