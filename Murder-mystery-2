local function makeHBtn(xOff,sym,sz,tsz)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(0,sz,0,sz); b.Position=UDim2.new(1,xOff,0.5,-sz/2)
    b.BackgroundColor3=rgb(22,22,32); b.BackgroundTransparency=0.30
