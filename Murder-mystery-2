-- tween helpers
local function tw(o,t,p,s,d)
    if not o or not o.Parent then return end
    local tn=TweenService:Create(o,TweenInfo.new(t,s or Enum.EasingStyle.Quart,d or Enum.EasingDirection.Out),p)
    tn:Play(); return tn
end
local function twBack(o,t,p)   return tw(o,t,p,Enum.EasingStyle.Back,   Enum.EasingDirection.Out) end
local function twSine(o,t,p)   return tw(o,t,p,Enum.EasingStyle.Sine,   Enum.EasingDirection.Out) end
local function twLinear(o,t,p) return tw(o,t,p,Enum.EasingStyle.Linear, Enum.EasingDirection.Out) end

local function corner(o,r)
    local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,r or 8); c.Parent=o; return c
end
local function stroke(o,col,th,tr)
    local s=Instance.new("UIStroke"); s.Color=col or theme.card; s.Thickness=th or 1
    s.Transparency=tr or 0; s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border; s.Parent=o; return s
end
local function uipad(o,l,r,t,b)
    local p=Instance.new("UIPadding")
    p.PaddingLeft=UDim.new(0,l or 0); p.PaddingRight=UDim.new(0,r or 0)
    p.PaddingTop=UDim.new(0,t or 0); p.PaddingBottom=UDim.new(0,b or 0)
    p.Parent=o
end

