    xb.BackgroundColor3=rgb(28,28,40)
    xb.BackgroundTransparency=0.30
    xb.Text="×"
    xb.Font=Enum.Font.GothamBold
    xb.TextSize=12
    xb.TextColor3=theme.sub
    xb.ZIndex=104
    xb.Parent=f
    corner(xb,9)
    xb.MouseEnter:Connect(function() tw(xb,0.12,{BackgroundTransparency=0,TextColor3=W3}) end)
    xb.MouseLeave:Connect(function() tw(xb,0.16,{BackgroundTransparency=0.30,TextColor3=theme.sub}) end)

    -- Progress bar — heavily rounded, small, centered at bottom with margins
    local barBg=Instance.new("Frame")
    barBg.AnchorPoint=Vector2.new(0.5,1)
    barBg.Position=UDim2.new(0.5,0,1,-6)
    barBg.Size=UDim2.new(1,-24,0,4)
    barBg.BackgroundColor3=rgb(22,22,32)
    barBg.BackgroundTransparency=0.20
    barBg.BorderSizePixel=0
    barBg.ZIndex=103
    barBg.Parent=f
    corner(barBg,999)

    local bar=Instance.new("Frame")
    bar.Size=UDim2.new(1,0,1,0)
    bar.BackgroundColor3=theme.primary
    bar.BorderSizePixel=0
    bar.ZIndex=104
    bar.Parent=barBg
    corner(bar,999)
    onTheme(function(p) bar.BackgroundColor3=p end)

    n.f=f; n.shadow=shadow; n.glow=glow; table.insert(activeNotifs,n)

    -- Animate in: slide from top-right corner + expand
    task.spawn(function()
        tw(shadow,0.45,{BackgroundTransparency=0.72})
        tw(f,0.40,{BackgroundTransparency=0.06})
        tw(glow,0.50,{BackgroundTransparency=0.96})
        twBack(f,0.48,{Size=UDim2.new(0,260,0,64),Position=UDim2.new(1,0,0,0)})
    end)

    -- Icon pop
    iconFrame.Size=UDim2.new(0,8,0,8)
    iconFrame.BackgroundTransparency=1
    task.delay(0.14,function()
        if iconFrame and iconFrame.Parent then
            twBack(iconFrame,0.34,{Size=UDim2.new(0,24,0,24),BackgroundTransparency=0.85})
        end
    end)

    -- Progress bar shrink
    twLinear(bar,dur,{Size=UDim2.new(0,0,1,0)})

    -- Dismiss handlers
    f.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dismissNotif(n) end
    end)
    xb.MouseButton1Click:Connect(function() dismissNotif(n) end)
    task.delay(dur,function() dismissNotif(n) end)
    return n
end

